{
    "name": "semitexa/laravel-ai-verify",
    "description": "Stop AI coding agents from faking \"done\" in Laravel. One Artisan command verifies Claude Code, Cursor and Codex changes: only the tests, Larastan, Pint and Laravel checks the diff needs, a guard against deleted or skipped tests, AGENTS.md/CLAUDE.md setup and a Claude Code hook.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "ai",
        "ai-agents",
        "ai-code-review",
        "ai-code-verification",
        "claude-code",
        "cursor",
        "codex",
        "copilot",
        "gemini-cli",
        "agents-md",
        "claude-md",
        "vibe-coding",
        "reward-hacking",
        "testing",
        "pest",
        "phpunit",
        "phpstan",
        "larastan",
        "pint",
        "test-impact-analysis",
        "affected-tests",
        "code-graph",
        "laravel-boost",
        "semitexa"
    ],
    "homepage": "https://semitexa.com",
    "support": {
        "issues": "https://github.com/semitexa/laravel-ai-verify/issues",
        "source": "https://github.com/semitexa/laravel-ai-verify"
    },
    "authors": [
        {
            "name": "Semitexa",
            "email": "support@semitexa.com",
            "homepage": "https://semitexa.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "symfony/process": "^7.2|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Semitexa\\LaravelAiVerify\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Semitexa\\LaravelAiVerify\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Semitexa\\LaravelAiVerify\\AiVerifyServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
